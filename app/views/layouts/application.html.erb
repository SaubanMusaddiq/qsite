<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>ದಿವ್ಯ ಕುರ್‍ಆನ್ <%= yield(:title) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta http-equiv="Content-Language" content="EN; AR" />
    <meta data-react-helmet="true" name="keywords" content="divya quran,quran, kannada ,quran in kannada, kannada quran, shanti prakashana, kareem, قران, القرآن, قران كريم, القران الكريم, surah, yasin, yaseen, kahf, mulk, rahman, islam, Allah"/>
    <meta property="og:title" content="ದಿವ್ಯ ಕುರ್‍ಆನ್">
    <meta property="og:description" content="Divya Quran"/>
    <meta property="og:url" content="<%= request.original_url %>"/>
    <meta property="og:image" itemprop="image"  content=""/>
    <meta property="og:type" content="website" />
    <meta property="og:image:type" content="image/jpeg">
    <meta property="og:image:width" content="256">
    <meta property="og:image:height" content="256">
    <title>DivyaQuran</title>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>


    <script src="https://code.jquery.com/jquery-3.2.1.min.js" crossorigin="anonymous"></script>

    <link rel="icon" type="image/png" href="/images/logo.png" />

        <!-- Latest compiled and minified CSS -->
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/sharetastic.css">

    <link href="/font-awesome/css/font-awesome.css" rel="stylesheet" />
<!--     <link rel="stylesheet" href="/css/slidebars.css">
 -->    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/3.5.2/animate.min.css">
    <%= yield :page_links %>

    <!-- Latest compiled and minified JavaScript -->
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js" integrity="sha384-Tc5IQib027qvyjSMfHjOMaLkfuWVxZxUPnCJA7l2mCWNIpG9mGCD8wGNIcPD7Txa" crossorigin="anonymous"></script>
    <!-- <script src="/js/slidebars.js"></script> -->
    <script src="/js/site.js"></script>
    <script src="/js/sharetastic.js"></script>
  </head>

  <body>
    

    <div id="page-content">
      <%= yield %>
    </div>

    <div>
      <a href="#" id="back-to-top" style="display: none;" title="Back to Top"><span></span></a>
    </div>
    <div id="footer">
      <ul class="items">
          <li><a class="footer-3" href="https://play.google.com/store/apps/details?id=com.nzymic.quran&hl=en_US">Mobile App</a></li>
      </ul>

      <div id="cp-right">
      <p>© Divya Quran - ದಿವ್ಯ ಕುರ್‍ಆನ್</p>
      </div>
    </div>
    <%= render "shared/header_settings_panel" %>
  </body>
</html>
