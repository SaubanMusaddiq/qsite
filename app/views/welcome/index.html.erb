<% title "Home Page" %>
<div id="site-banner">
</div>
<div id="header">
      <nav class="navbar navbar-default">
        <div class="container-fluid navbar-custom">
          <div class="navbar-header navbar-icon-left">
            <button type="button" class="navbar-toggle collapsed" id="navbar-button"data-toggle="collapse" data-target="#navbar-collapse-content" aria-expanded="false">
              <span class="sr-only">Toggle navigation</span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
            </button>
          </div>
          

          <!-- Collect the nav links, forms, and other content for toggling -->
          <div class="collapse navbar-collapse chapter-navigator" id="navbar-collapse-content">
            <%= render "shared/header_chapter_navigator" %>
          </div><!-- /.navbar-collapse -->
          <div class="navbar-icon-right">
            <%= link_to image_tag("/images/sp.png", border: 0, id: "header-logo-img-2"), "/",{class: "", "data-turbolinks": "false"} %>
          </div>
        </div><!-- /.container-fluid -->
      </nav>
    </div>

<div class="content-body container-fluid">
	<div class="row">
		<div class="col-md-10 col-md-offset-1">
			<h4 class="line-text"><span >ಅಧ್ಯಾಯಗಳು</span></h4>
			<div class="row chapter-list">
				<ul class="col-md-4 list-unstyled list-left">
					<%@first_third_chapters.each do |chap|%>
						<li>
							<a href="/<%=chap.number%>" class="row chap-a">
								<div class="row">
									<div class="col-xs-1 chapter-num"><span><%=chap.number%></span></div>
									<div class="col-xs-5"><span><%=chap.title_kn%></span></div>
									<div class="col-xs-5 chap-ar"><span class="home-surah<%=chap.number%> home-surah"><%= chap.number.to_s.rjust(3, '0') %></span></div>
								</div>
								<div class="row">
									<div class="col-xs-5 chap-tkn col-xs-offset-1"><span><%=chap.title_trans_kn%></span></div>
								</div>
							</a>
						</li>
					<%end%>
				</ul>
				<ul class="col-md-4 list-unstyled  list-right">
					<%@second_third_chapters.each do |chap|%>
						<li>
							<a href="/<%=chap.number%>" class="row chap-a">
								<div class="row">
									<div class="col-xs-1 chapter-num"><span><%=chap.number%></span></div>
									<div class="col-xs-5"><span><%=chap.title_kn%></span></div>
									<div class="col-xs-5 chap-ar"><span class="home-surah<%=chap.number%> home-surah"><%= chap.number.to_s.rjust(3, '0') %></span></div>
								</div>
								<div class="row">
									<div class="col-xs-5 chap-tkn col-xs-offset-1"><span><%=chap.title_trans_kn%></span></div>
								</div>
							</a>
						</li>
					<%end%>
				</ul>
				<ul class="col-md-4 list-unstyled  list-right">
					<%@third_third_chapters.each do |chap|%>
						<li>
							<a href="/<%=chap.number%>" class="row chap-a">
								<div class="row">
									<div class="col-xs-1 chapter-num"><span><%=chap.number%></span></div>
									<div class="col-xs-5"><span><%=chap.title_kn%></span></div>
									<div class="col-xs-5 chap-ar"><span class="home-surah<%=chap.number%> home-surah"><%= chap.number.to_s.rjust(3, '0') %></span></div>
								</div>
								<div class="row">
									<div class="col-xs-5 chap-tkn col-xs-offset-1"><span><%=chap.title_trans_kn%></span></div>
								</div>
							</a>
						</li>
					<%end%>
				</ul>
			</div>
		</div>
	</div>
</div>
